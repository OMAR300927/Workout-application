pipeline {
    agent any
    
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        USERNAME = 'omarsa999'
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/OMAR300927/Workout-application.git'
            }
        }
        
        stage('Test') {
            steps {
                withCredentials([file(credentialsId: 'env-file', variable: 'ENV_FILE')]) {
                    sh '''
                    cp $ENV_FILE .env
                    export PYTHONPATH=$WORKSPACE
                    export PATH=/root/.local/bin:$PATH
        
                    uv sync --frozen
                    uv run python -m pytest tests/
                    '''
                }
            }
        }
        
        stage('Gitleaks scan') {
            steps {
                sh 'gitleaks detect --source . --exit-code 1'
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=workout-app \
                    -Dsonar.projectKey=workout-app \
                    -Dsonar.exclusions=tests/**
                    '''
                }
            }
        }
        
        stage('Quality gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true, credentialsId: 'sonar-cred'
                }
            }
        }
        
        stage('File system scan') {
            steps {
                sh 'trivy fs . --format table -o fs-report.html'
            }
        }
        
        stage('Build & tag the image') {
            steps {
                sh 'docker build -t $USERNAME/workout-app .'
            }
        }
        
        stage('Scan the image') {
            steps {
                sh 'trivy image --timeout 10m --format table -o image-report.html $USERNAME/workout-app'
            }
        }
        
        stage('Push the image') {
            steps {
                withDockerRegistry(credentialsId: 'docker-cred', url: 'https://index.docker.io/v1/') {
                    sh 'docker push $USERNAME/workout-app'
                }
            }
        }

        stage('Apply Kubernetes manifests') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh 'kubectl apply -f ./K8s/'
                    sh 'kubectl rollout status deployment/fastapi-deployment'
                }
            }
        }

        stage('Verify the Deployment') {
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh 'kubectl get pods -o wide'
                }
            }
        }
    }
}